{
  "server": {
    "name": "Example MCP Server",
    "version": "0.0.0",
    "description": "Example config. Copy to tools.config.json and edit for your environment."
  },
  "baseUrlEnvKey": "API_BASE_URL",
  "authTokenEnvKey": "MCP_AUTH_TOKEN",
  "tools": [
    {
      "name": "get_artist_by_id",
      "description": "Fetch an artist by ID (example)",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The ID of the artist to fetch"
          }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "http": {
        "method": "POST",
        "path": "/get-artist-by-id",
        "body": {
          "mode": "json",
          "mapping": "full"
        },
        "headers": {
          "Authorization": "Bearer YOUR_API_TOKEN"
        }
      },
      "response": {
        "mode": "json",
        "contentPath": null,
        "wrap": {
          "type": "text",
          "template": "Artist response:\\n\\n{{body}}"
        }
      }
    }
  ]
}
